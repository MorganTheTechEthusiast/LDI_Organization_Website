PORT=5050
HOST=0.0.0.0
JWT_SECRET=change-this-secret-in-production
SUPER_ADMIN_EMAIL=admin@liberiadigitalinsights.org
CLIENT_ORIGIN=http://localhost:5173

# Development database: SQLite
# 
# SQLITE_PATH=./data/ldi.sqlite

Production database: PostgreSQL
In Railway production variables, set:
DB_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PGSSL=false

# Cloudinary image uploads (server-only secrets)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLIENT_ORIGIN=https://your-frontend.example

# Automated applicant email notifications
# Recommended for Railway: Brevo HTTPS API (SMTP connections may time out)
# Verify MAIL_FROM in Brevo, then create an API key and add it in Railway.
BREVO_API_KEY=
MAIL_FROM=liberiadigitalinsights@gmail.com
# Use one frontend URL only. Do not copy the comma-separated CLIENT_ORIGIN list here.
PUBLIC_APP_URL=http://localhost:5173

# Optional SMTP fallback for local development or plans that allow SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=liberiadigitalinsights@gmail.com
SMTP_PASS=your-gmail-app-password

# One-time migration from local SQLite to production PostgreSQL
# CONFIRM_MIGRATE_TO_POSTGRES=true
