PORT=5050
HOST=0.0.0.0
JWT_SECRET=change-this-secret-in-production
CLIENT_ORIGIN=http://localhost:5173

# Development database: SQLite
# Leave DB_CLIENT empty to auto-select PostgreSQL when DATABASE_URL is set.
DB_CLIENT=
SQLITE_PATH=./data/ldi.sqlite

# Production database: PostgreSQL
# In Railway production variables, set:
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# PGSSL=false

# Cloudinary image uploads (server-only secrets)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLIENT_ORIGIN=https://your-frontend.example

# One-time migration from local SQLite to production PostgreSQL
# CONFIRM_MIGRATE_TO_POSTGRES=true
